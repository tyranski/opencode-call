{
  "name": "opencode-call",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "opencode:inspect": "node src/cli.js inspect",
    "opencode:sessions": "node src/cli.js sessions",
    "opencode:progress": "node src/cli.js progress",
    "opencode:watch": "node src/cli.js watch",
